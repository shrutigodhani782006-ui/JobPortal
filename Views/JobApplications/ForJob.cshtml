@model IEnumerable<JobPortal.Models.JobApplication>
@{
    ViewData["Title"] = "Applications for " + ViewBag.JobTitle;
}

<div class="container my-5">
    <!-- Header Card -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body bg-light">
            <h2 class="fw-bold mb-1">@ViewBag.JobTitle</h2>
            <h5 class="text-secondary mb-0">Company: @ViewBag.CompanyName</h5>
        </div>
    </div>

    <!-- Messages -->
    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm">@ViewBag.Success</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm">@ViewBag.Error</div>
    }

    <!-- Applications Table -->
    <div class="card shadow-lg border-0 rounded-4 mt-3">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0 applications-table">
                    <thead class="table-light">
                        <tr>
                            <th>Applicant</th>
                            <th>Resume</th>
                            <th>Cover Letter</th>
                            <th>Status</th>
                            <th>Applied On</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            var rowClass = "";
                            switch (app.Status)
                            {
                                case JobPortal.Models.ApplicationStatus.Applied:
                                    rowClass = "applied-row"; break;
                                case JobPortal.Models.ApplicationStatus.Shortlisted:
                                    rowClass = "shortlisted-row"; break;
                                case JobPortal.Models.ApplicationStatus.Rejected:
                                    rowClass = "rejected-row"; break;
                                case JobPortal.Models.ApplicationStatus.Hired:
                                    rowClass = "hired-row"; break;
                            }
                            <tr class="@rowClass">
                                <td class="fw-semibold">@app.Applicant?.UserName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(app.ResumePath))
                                    {
                                        <a href="@Url.Content(app.ResumePath)" target="_blank" class="text-decoration-none fw-semibold text-primary">
                                            View Resume
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Resume</span>
                                    }
                                </td>
                                <td>@app.CoverLetter</td>
                                <td>
                                    @switch (app.Status)
                                    {
                                        case JobPortal.Models.ApplicationStatus.Applied:
                                            <span class="badge bg-primary">Applied</span>
                                            break;
                                        case JobPortal.Models.ApplicationStatus.Shortlisted:
                                            <span class="badge bg-info text-dark">Shortlisted</span>
                                            break;
                                        case JobPortal.Models.ApplicationStatus.Rejected:
                                            <span class="badge bg-danger">Rejected</span>
                                            break;
                                        case JobPortal.Models.ApplicationStatus.Hired:
                                            <span class="badge bg-success">Hired</span>
                                            break;
                                    }
                                </td>
                                <td>@app.AppliedAt.ToShortDateString()</td>
                                <td class="text-center">
                                    <div class="d-flex flex-wrap justify-content-center gap-1">
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="appId" value="@app.Id" />
                                            <input type="hidden" name="status" value="Shortlisted" />
                                            <button type="submit" class="btn btn-sm btn-info">Shortlist</button>
                                        </form>

                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="appId" value="@app.Id" />
                                            <input type="hidden" name="status" value="Rejected" />
                                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                        </form>

                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="appId" value="@app.Id" />
                                            <input type="hidden" name="status" value="Hired" />
                                            <button type="submit" class="btn btn-sm btn-success">Hire</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Card and table */
    .card {
        border-radius: 12px;
    }

    .applications-table {
        border-radius: 12px;
        overflow: hidden;
    }

    /* Row coloring by status */
    .applied-row {
        background-color: rgba(0, 123, 255, 0.15);
        ; /* light blue */
    }

    .shortlisted-row {
        background-color: rgba(0, 123, 255, 0.15);
        ; /* tealish light */
    }

    .rejected-row {
        background-color: rgba(0, 123, 255, 0.15);
        ; /* light red */
    }

    .hired-row {
        background-color: rgba(0, 123, 255, 0.15);
        ; /* light green */
    }

    /* Hover effect */
    .applications-table tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.15);
    }

    /* Badge sizes */
    .badge {
        font-size: 0.9rem;
        padding: 0.45em 0.75em;
    }

    /* Buttons */
    .btn-sm {
        padding: 0.35rem 0.6rem;
        font-size: 0.875rem;
    }

    /* Table responsiveness */
    .table-responsive {
        overflow-x: auto;
    }

    /* Mobile adjustments */
    @@media (max-width: 576px) {
        .d-flex.flex-wrap.justify-content-center.gap-1

    {
        flex-direction: column;
    }

    }
</style>
