@model JobPortal.Models.JobApplicationViewModel
@{
    ViewData["Title"] = "Apply for Job";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4 bg-lightblue">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="mb-0 fw-bold">Apply for: @ViewBag.JobTitle</h2>
        </div>
        <div class="card-body p-4">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form asp-action="Apply" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="JobId" />

                <div class="mb-3">
                    <label asp-for="CoverLetter" class="form-label fw-semibold">Cover Letter</label>
                    <textarea asp-for="CoverLetter" class="form-control rounded-3" rows="5"></textarea>
                    <span asp-validation-for="CoverLetter" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Experience" class="form-label fw-semibold">Experience (in years)</label>
                    <input asp-for="Experience" type="number" class="form-control rounded-3" />
                    <span asp-validation-for="Experience" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ResumeFile" class="form-label fw-semibold">Upload Resume (PDF)</label>
                    <input asp-for="ResumeFile" type="file" class="form-control rounded-3" />
                    <span asp-validation-for="ResumeFile" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">Submit Application</button>
                    <a asp-action="Details" asp-controller="Jobs" asp-route-id="@Model.JobId" class="btn btn-outline-secondary flex-fill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-lightblue {
            background-color: #e6f7ff;
        }

        .form-control {
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .form-control:focus {
                border-color: #3399ff;
                box-shadow: 0 0 0 0.2rem rgba(51, 153, 255, 0.25);
            }

        .btn-primary {
            transition: all 0.2s ease;
        }

            .btn-primary:hover {
                background-color: #66b0ff;
                border-color: #66b0ff;
                transform: translateY(-1px);
            }

        .btn-outline-secondary {
            transition: all 0.2s ease;
        }

            .btn-outline-secondary:hover {
                background-color: #cce4ff;
                border-color: #3399ff;
                color: #003366;
            }

        .fw-semibold {
            font-weight: 600;
        }
    </style>
}
