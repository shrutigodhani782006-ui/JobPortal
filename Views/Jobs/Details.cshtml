@model JobPortal.Models.Job
@{
    ViewData["Title"] = "Job Details";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="mb-0 fw-bold">@Model.Title</h2>
        </div>
        <div class="card-body p-4">
            <!-- Company and Location -->
            <div class="mb-3">
                <h5 class="fw-semibold">Company: <span class="text-secondary">@Model.Company?.Name</span></h5>
                <p class="mb-1"><strong>Location:</strong> @Model.Location</p>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <h5 class="fw-semibold">Description:</h5>
                <p>@Model.Description</p>
            </div>

            <!-- Skills and Employment -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Skills Required:</strong> @Model.Skills</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Employment Type:</strong> @Model.EmploymentType</p>
                </div>
            </div>

            <!-- Salary and Posted Date -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <p>
                        <strong>Salary:</strong>
                        @if (Model.SalaryFrom.HasValue || Model.SalaryTo.HasValue)
                        {
                            @($"{Model.SalaryFrom:C} - {Model.SalaryTo:C}")
                        }
                        else
                        {
                            @("Not specified")
                        }
                    </p>
                </div>
                <div class="col-md-6">
                    <p><strong>Posted On:</strong> @Model.PostedAt.ToShortDateString()</p>
                </div>
            </div>

            <!-- Apply / Cancel Button -->
            @if (User.Identity.IsAuthenticated && User.IsInRole("JobSeeker"))
            {
                var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value;
                var hasApplied = ViewBag.HasApplied != null && (bool)ViewBag.HasApplied;

                if (hasApplied)
                {
                    <div class="d-flex gap-2 mt-3">
                        <div class="alert alert-info flex-grow-1 mb-0">
                            ✅ You have already applied for this job.
                        </div>
                        <form asp-controller="JobApplications"
                              asp-action="Cancel"
                              asp-route-id="@ViewBag.ApplicationId"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to cancel this application?');">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle me-1"></i> Cancel Application
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-controller="JobApplications"
                       asp-action="Apply"
                       asp-route-jobId="@Model.Id"
                       class="btn btn-primary btn-lg w-100 mt-3">
                        Apply Now
                    </a>
                }
            }

        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    .card {
        border-radius: 12px;
    }

    .card-header {
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }

    .fw-semibold {
        font-weight: 600;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 123, 255, 0.2);
        }

    .btn-danger {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    @@media (max-width: 576px) {
        .row > div {
            margin-bottom: 1rem;
        }
    }
</style>
