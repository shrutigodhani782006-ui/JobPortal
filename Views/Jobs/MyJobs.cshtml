@model IEnumerable<JobPortal.Models.Job>

@{
    ViewData["Title"] = "My Jobs";
    var activeJobs = Model.Where(j => j.IsActive).ToList();
    var inactiveJobs = Model.Where(j => !j.IsActive).ToList();
}

<div class="container my-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-briefcase-fill me-2"></i> My Jobs
        </h2>
        <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Create New Job
        </a>
    </div>

    <!-- Active Jobs Table -->
    @if (activeJobs.Any())
    {
        <div class="card shadow-sm mb-5 rounded-4">
            <div class="card-header bg-lightblue py-2 rounded-top-4 fw-semibold text-dark">
                Active Jobs
            </div>
            <div class="card-body p-3 table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Company</th>
                            <th>Location</th>
                            <th>Posted On</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in activeJobs)
                        {
                            <tr>
                                <td>@job.Title</td>
                                <td>@job.Company?.Name</td>
                                <td>@job.Location</td>
                                <td>@job.PostedAt.ToShortDateString()</td>
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm me-1">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary btn-sm me-1">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="JobApplications"
                                       asp-action="ForJob"
                                       asp-route-jobId="@job.Id"
                                       class="btn btn-outline-info btn-sm me-1">
                                        <i class="bi bi-people-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Inactive/Old Jobs Cards -->
    @if (inactiveJobs.Any())
    {
        <h4 class="text-secondary mb-3">Inactive / Older Jobs</h4>
        <div class="row g-4">
            @foreach (var job in inactiveJobs)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 job-card inactive-job-card">
                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold text-dark mb-1">
                                <i class="bi bi-briefcase-fill text-info me-2"></i> @job.Title
                            </h5>
                            <p class="text-secondary mb-2">
                                <i class="bi bi-building me-1"></i> @job.Company?.Name
                            </p>

                            <div class="d-flex justify-content-between small text-muted mb-3">
                                <span><i class="bi bi-geo-alt-fill text-primary me-1"></i> @job.Location</span>
                                <span><i class="bi bi-calendar-event text-warning me-1"></i> @job.PostedAt.ToShortDateString()</span>
                            </div>

                            <div class="mb-3">
                                <span class="badge bg-secondary px-3 py-2">Inactive</span>
                            </div>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary btn-sm flex-fill">
                                    <i class="bi bi-eye me-1"></i> View
                                </a>
                                <a asp-controller="JobApplications"
                                   asp-action="ForJob"
                                   asp-route-jobId="@job.Id"
                                   class="btn btn-outline-info btn-sm flex-fill">
                                    <i class="bi bi-people-fill me-1"></i> Applications
                                </a>
                                <a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-outline-danger btn-sm flex-fill">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    /* Table hover */
    .table-hover tbody tr:hover {
        background-color: #e6f0ff; /* soft light blue */
    }

    .bg-lightblue {
        background-color: #d9eaff !important; /* light blue header */
    }

    /* Card hover effect */
    .job-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #e5e5e5;
        background: #ffffff;
    }

        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.08);
        }

    /* Inactive jobs soft blue */
    .inactive-job-card {
        background-color: #e6f2ff;
        border: 1px solid #cce4ff;
    }

    /* Badges */
    .badge {
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 0.5rem;
    }

    /* Buttons hover */
    .btn-outline-primary:hover {
        background-color: #cce4ff;
        border-color: #66b0ff;
    }

    .btn-outline-info:hover {
        background-color: #d0f0fd;
        border-color: #0dcaf0;
    }

    .btn-outline-danger:hover {
        background-color: #fde2e2;
        border-color: #dc3545;
    }

    /* Typography */
    h5 {
        font-size: 1.1rem;
    }

    .text-secondary {
        font-size: 0.95rem;
    }
</style>
