@model IEnumerable<JobPortal.Models.Job>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<div class="container my-5">
    <h2 class="fw-bold text-primary mb-4"><i class="bi bi-briefcase-fill me-2"></i> Available Jobs</h2>

    <!-- Search Form -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control rounded-pill" placeholder="Job title" value="@Context.Request.Query["search"]" />
        </div>
        <div class="col-md-3">
            <input type="text" name="location" class="form-control rounded-pill" placeholder="Location" value="@Context.Request.Query["location"]" />
        </div>
        <div class="col-md-3">
            <input type="text" name="skill" class="form-control rounded-pill" placeholder="Skill" value="@Context.Request.Query["skill"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 rounded-pill"><i class="bi bi-search me-1"></i> Search</button>
        </div>
    </form>


    <!-- Job Cards -->
    <div class="row g-4">
        @foreach (var j in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4 job-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="fw-bold mb-2 text-primary">@j.Title</h5>
                        <p class="mb-1"><i class="bi bi-building me-1 text-secondary"></i> @j.Company?.Name </p>
                        <p class="mb-1"><i class="bi bi-geo-alt-fill me-1 text-danger"></i> @j.Location</p>
                        <p class="mb-2"><strong>Skills:</strong> @j.Skills</p>
                        <p class="mb-3 text-muted small"><i class="bi bi-calendar-event me-1"></i> Posted: @j.PostedAt.ToShortDateString()</p>

                        <div class="mt-auto d-flex gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@j.Id" class="btn btn-outline-secondary btn-sm flex-fill">
                                <i class="bi bi-eye me-1"></i> View
                            </a>

                            @* Apply button for Job Seekers *@
                            @if (User.Identity.IsAuthenticated)
                            {
                                var currentUser = await UserManager.GetUserAsync(User);
                                if (currentUser != null && !currentUser.IsEmployer)
                                {
                                    <a asp-controller="JobApplications"
                                       asp-action="Apply"
                                       asp-route-jobId="@j.Id"
                                       class="btn btn-primary btn-sm flex-fill">
                                        <i class="bi bi-send-fill me-1"></i> Apply
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    .job-card {
        background-color: #e6f2ff; /* light blue card */
        border: 1px solid #cce4ff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .form-control {
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: #3399ff;
            box-shadow: 0 0 0 0.2rem rgba(51, 153, 255, 0.25);
        }

    .btn-primary, .btn-outline-secondary {
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            background-color: #66b0ff;
            border-color: #66b0ff;
            color: #fff;
            transform: translateY(-2px);
        }

        .btn-outline-secondary:hover {
            background-color: #cce4ff;
        }

    h5, p {
        margin-bottom: 0.5rem;
    }
</style>
