@model JobPortal.Models.Job
@{
    ViewData["Title"] = "Delete Job";
}

<div class="container my-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-3">Delete Job</h2>

            <div class="alert alert-danger alert-soft rounded-4 mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Are you sure you want to delete this job?
            </div>

            <div class="my-4">
                <dl class="row">
                    <dt class="col-sm-3 fw-semibold">Title</dt>
                    <dd class="col-sm-9">@Model.Title</dd>

                    <dt class="col-sm-3 fw-semibold">Company</dt>
                    <dd class="col-sm-9">@Model.Company?.Name</dd>

                    <dt class="col-sm-3 fw-semibold">Location</dt>
                    <dd class="col-sm-9">@Model.Location</dd>
                </dl>
            </div>

            <form asp-action="Delete" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger btn-lg flex-grow-1">
                    Delete
                </button>
                <a asp-action="MyJobs" class="btn btn-primary btn-lg flex-grow-1">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
    }

    .alert-soft {
        background-color: #fdecea; /* soft red/pink */
        color: #b71c1c; /* darker red text */
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        padding: 0.8rem 1rem;
    }

    .btn-lg {
        padding: 0.65rem 1rem;
        font-size: 1.05rem;
    }

    .btn-danger:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.2);
        transition: all 0.2s ease;
    }

    dl.row dt {
        margin-bottom: 0.5rem;
    }

    dl.row dd {
        margin-bottom: 1rem;
    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
