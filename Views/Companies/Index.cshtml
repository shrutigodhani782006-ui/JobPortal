@model IEnumerable<JobPortal.Models.Company>

<div class="container my-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
           Companies
        </h2>
        <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Company
        </a>
    </div>

    <!-- Companies Table -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-info-circle display-3 text-muted"></i>
            <p class="mt-3 text-muted fs-5">No companies added yet.</p>
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-1"></i> Add Your First Company
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle companies-table rounded-4">
                <thead class="companies-table-header">
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.Location</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm me-1">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    /* Table styling */
    .companies-table {
        background-color: #e6f2ff; /* soft light blue */
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .companies-table-header {
        background-color: #cce4ff; /* slightly darker blue for header */
    }

    .companies-table tbody tr:hover {
        background-color: #d0eaff; /* slightly brighter hover effect */
        transition: background-color 0.2s ease;
    }

    /* Buttons */
    .btn-outline-primary {
        border-radius: 0.5rem;
        transition: all 0.2s ease;
    }

        .btn-outline-primary:hover {
            background-color: #cce4ff;
            border-color: #66b0ff;
        }

    .btn-outline-danger {
        border-radius: 0.5rem;
        transition: all 0.2s ease;
    }

        .btn-outline-danger:hover {
            background-color: #fde2e2;
            border-color: #dc3545;
        }

    /* Typography */
    h2 {
        font-size: 1.8rem;
    }

    .text-muted {
        font-size: 1rem;
    }

    /* Responsive table */
    @@media (max-width: 576px) {
        .companies-table th, .companies-table td

    {
        font-size: 0.9rem;
    }

    .btn {
        font-size: 0.85rem;
    }

    }
</style>
