@model JobPortal.Models.Company
@{
    ViewData["Title"] = "Create Company";
}

<div class="container my-5">
    <h2 class="fw-bold text-primary mb-4">
        Create Company
    </h2>

    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
        <div class="alert alert-danger">@err.ErrorMessage</div>
    }

    <div class="card shadow-sm rounded-4 p-4 create-company-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control rounded-pill" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control rounded" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label fw-semibold"></label>
                <input asp-for="Location" class="form-control rounded-pill" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg rounded-pill save-btn">
                <i class="bi bi-check-circle me-1"></i> Save
            </button>
        </form>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    .create-company-card {
        background-color: #e6f2ff; /* soft light blue */
        border: 1px solid #cce4ff;
    }

    .form-control {
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: #3399ff;
            box-shadow: 0 0 0 0.2rem rgba(51,153,255,0.25);
        }

    /* Save button */
    .save-btn {
        background-color: #3399ff; /* light blue dashboard theme */
        border-color: #3399ff;
        color: #fff;
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .save-btn:hover {
            background-color: #66b0ff; /* lighter blue on hover */
            border-color: #66b0ff;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 8px rgba(0,0,0,0.15);
        }

    .form-label {
        font-size: 1rem;
    }

    @@media (max-width: 576px) {
        .btn-lg

    {
        font-size: 0.9rem;
    }

    .form-control {
        font-size: 0.95rem;
    }

    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
